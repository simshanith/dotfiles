{{ if and (not .work) (eq .chezmoi.os "darwin") -}}
#!/bin/sh
# Bundle personal-machine Homebrew extras (work=false only).
#
# The main Brewfile is common + headless-safe and un-templated. Per-machine
# casks live in Brewfile.home / Brewfile.work; this hook applies the personal
# set, gated on the .work flag answered at `chezmoi init`. Work machines render
# this script empty, so chezmoi skips it. run_onchange: re-bundles whenever
# Brewfile.home changes.
#
# Brewfile.home sha256: {{ include "Brewfile.home" | sha256sum }}
set -eu
brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile.home" || true
{{ end -}}
