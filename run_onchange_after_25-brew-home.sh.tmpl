{{ if and (eq .chezmoi.os "darwin") (get . "home") -}}
#!/bin/sh
# Bundle personal-machine GUI/desktop Homebrew casks (macOS + opt-in only).
#
# Gated on the `home` flag (answered at `chezmoi init`): only personal daily-
# drivers auto-install these. Work/servers/CI/Coder answer false (the default)
# and skip this entirely. The main Brewfile stays common + headless-safe and
# un-templated; personal desktop casks live in Brewfile.home.
# run_onchange: re-bundles whenever Brewfile.home changes.
#
# Brewfile.home sha256: {{ include "Brewfile.home" | sha256sum }}
set -eu
brew bundle --file="{{ .chezmoi.sourceDir }}/Brewfile.home" || true
{{ end -}}
