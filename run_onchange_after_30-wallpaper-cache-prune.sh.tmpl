{{- $label := printf "%s.wallpaper-cache-prune" (get . "launchd_prefix" | default "local.dotfiles") -}}
{{ if and (eq .chezmoi.os "darwin") (stat (joinPath .chezmoi.homeDir "Library/Containers/com.apple.wallpaper.agent/Data/Library/Caches/com.apple.wallpaper.caches/extension-com.apple.wallpaper.extension.image")) -}}
#!/bin/sh
# Build + ad-hoc sign the wallpaper-cache-prune helper and (re)load its
# LaunchAgent (image-wallpaper Macs only; same stat gate as .chezmoiignore).
# run_onchange: reruns whenever the Swift source or the rendered plist (inlined
# below, so it's part of this script's hash) changes.
#
# Needs Full Disk Access, added once via System Settings (+ → ⇧⌘G → paste).
# The first-run "access data from other apps" prompt alone didn't persist for
# this ad-hoc-signed tool. Grants are tied to the cdhash: a byte-identical
# rebuild keeps the old binary (and grant); a changed one needs re-adding, and
# the stale entry must be removed (−) first: adding over it doesn't refresh it.
#
# source sha256: {{ include "macos/wallpaper-cache-prune.swift" | sha256sum }}
set -eu
command -v swiftc >/dev/null || { echo "wallpaper-cache-prune: swiftc missing (xcode-select --install); skipping" >&2; exit 0; }

dir="$HOME/Library/Application Support/wallpaper-cache-prune"
bin="$dir/wallpaper-cache-prune"
label="{{ $label }}"
plist="$HOME/Library/LaunchAgents/$label.plist"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

swiftc -O -o "$tmp/wallpaper-cache-prune" "{{ .chezmoi.sourceDir }}/macos/wallpaper-cache-prune.swift"
codesign --force --sign - --identifier "$label" "$tmp/wallpaper-cache-prune"

cdhash() { codesign -dvvv "$1" 2>&1 | sed -n 's/^CDHash=//p'; }
if [ -f "$bin" ] && [ "$(cdhash "$bin")" = "$(cdhash "$tmp/wallpaper-cache-prune")" ]; then
  echo "wallpaper-cache-prune: binary unchanged; Full Disk Access grant still valid"
else
  mkdir -p "$dir"
  mv -f "$tmp/wallpaper-cache-prune" "$bin"
  pane="x-apple.systempreferences:com.apple.preference.security?Privacy_AllFiles"
  echo "wallpaper-cache-prune: new binary — in Full Disk Access, remove (−) any old entry, then add (+ → ⇧⌘G → paste):" >&2
  echo "  $bin" >&2
  echo "  open the pane: open '$pane'" >&2
  if [ -t 1 ]; then
    printf %s "$bin" | pbcopy  # interactive apply: path ready to paste
    if [ "${WALLPAPER_PRUNE_OPEN_SETTINGS:-}" = 1 ]; then open "$pane"; fi  # opt-in auto-open
  fi
fi

# launchd_prefix changed since the last install: retire the old-label agent.
# The previous label is recorded next to the binary.
old=$(cat "$dir/label" 2>/dev/null || true)
if [ -n "$old" ] && [ "$old" != "$label" ]; then
  launchctl bootout "gui/$(id -u)/$old" 2>/dev/null || true
  rm -f "$HOME/Library/LaunchAgents/$old.plist"
fi

mkdir -p "$HOME/Library/LaunchAgents"
cat >"$plist" <<'PLIST'
{{ includeTemplate "wallpaper-cache-prune.plist" . | trim }}
PLIST
launchctl bootout "gui/$(id -u)" "$plist" 2>/dev/null || true  # not loaded yet is fine
launchctl bootstrap "gui/$(id -u)" "$plist"
printf %s "$label" >"$dir/label"
{{ end -}}
