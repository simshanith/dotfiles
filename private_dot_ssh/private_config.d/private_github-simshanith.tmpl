# Personal GitHub identity. dot_gitconfig.tmpl rewrites simshanith/* remotes to
# git@github-simshanith:..., so this alias must exist on every machine or those
# fetches/pushes fail with "Could not resolve hostname github-simshanith".
# IdentitiesOnly keeps ssh-agent from offering a different (e.g. work) key first.
# Override the key per machine with `personal_ssh_key` in chezmoi.toml [data].
Host github-simshanith
    HostName github.com
    User git
    IdentityFile {{ get . "personal_ssh_key" | default "~/.ssh/id_ed25519" }}
    IdentitiesOnly yes
