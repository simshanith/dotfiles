# chezmoi auto-ignores any source entry whose name begins with "." (verified):
#   .idea/ .claude/ .freshrc .DS_Store .git/ ...  — so they need no entry here.
#
# Patterns below are matched against TARGET paths (relative to $HOME). chezmoi
# does NOT apply gitignore "match at any depth" to slashless patterns (verified
# on v2.70.5): a bare "mise" suppresses ~/mise only and leaves the managed
# ~/.config/mise untouched. Each entry below therefore suppresses a top-level
# ~/ target we don't want chezmoi to create.

# Repo meta / docs — not dotfiles
README.md
readme.md
2026_REFRESH.md
CHEZMOI_MIGRATION.md
Brewfile*
dotfiles.sublime-project
bash_screenshot.png
install.sh
emacs.md
cheatsheets

# Source-only dirs: referenced by managed files (sourced from $DOTFILES, or
# vendored), but not themselves $HOME targets.
shell
tmux
git
mise
macos

# Deliberately unmanaged
backups
iterm2-preferences

# subl symlink only on macOS AND only when Sublime Text is actually installed
# (.chezmoiignore is itself templated; stat is re-evaluated every apply, so this
# self-corrects after `brew bundle` installs the app, or if it's removed).
{{ if or (ne .chezmoi.os "darwin") (not (stat "/Applications/Sublime Text.app")) }}bin/subl{{ end }}

# Wallpaper-cache prune agent only where image wallpapers get rendered (shuffle
# machines: the image-extension cache exists). Mostly-headless Macs on default
# aerial/video wallpaper have the container but no image cache, so they skip it;
# stat re-evaluates every apply. Non-darwin skips Library below.
{{ if not (stat (joinPath .chezmoi.homeDir "Library/Containers/com.apple.wallpaper.agent/Data/Library/Caches/com.apple.wallpaper.caches/extension-com.apple.wallpaper.extension.image")) }}Library/LaunchAgents/com.simshanith.wallpaper-cache-prune.plist{{ end }}

# rtk config: one shared template, two OS-specific targets. rtk hard-wires
# ~/Library/Application Support on darwin (ignores XDG) and ~/.config elsewhere.
{{ if ne .chezmoi.os "darwin" }}Library{{ else }}.config/rtk{{ end }}
